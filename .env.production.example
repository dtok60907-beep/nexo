# Copy to .env.production, replace required blanks, then chmod 600.
HTTP_PORT=80

# Local PostgreSQL container password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Spite remains on Neon until its database client is migrated from the
# Neon WebSocket driver to a standard PostgreSQL TCP client.
DATABASE_URL_SPITE=

# One-shot SPITE ownership migration only. Required for production runs of
# `node scripts/migrate-spite-ownership.mjs`. Long-running services should keep
# only their own service-specific database URLs.
SPITE_OWNER_USER_ID=
# Optional non-production escape hatch for deliberate test runs of the
# migration script when no explicit owner was configured.
# SPITE_ALLOW_DETERMINISTIC_FIRST_USER=1

# Realtime canvas internal URLs. Keep CANVAS_AUTH_URL and NEXOCLIP_INTERNAL_URL
# on the private Compose network; NEXT_PUBLIC_REALTIME_URL is browser-visible.
CANVAS_AUTH_URL=http://spite-realtime:3007/internal/authorize
NEXOCLIP_INTERNAL_URL=http://nexoclip:3000
NEXT_PUBLIC_REALTIME_URL=/spite/ws

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
LOCAL_OBJECT_STORAGE_SECRET=
AI_CLIP_RUNTIME_TOKEN=
SPITE_CRON_SECRET=
SCHEDULER_NEXTAUTH_SECRET=
R2_PROXY_SIGNING_SECRET=
CANVAS_AUTH_HMAC_SECRET=
REALTIME_JWT_SECRET=

# NexoClip providers and queue.
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
BYTEPLUS_API_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
BYTEPLUS_PROJECT_NAME=default
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_BASE_URL=
BYTEPLUS_SEEDANCE_2_ENDPOINT=ep-20260916130459-fw94z
BYTEPLUS_SEEDANCE_2_5_ENDPOINT=ep-20260916130618-t2z5j
BYTEPLUS_SEEDREAM_5_ENDPOINT=ep-20260916130838-dkscq
IMAGE_WORKER_CONCURRENCY=3
VIDEO_WORKER_CONCURRENCY=3

# Realtime durability / backpressure defaults.
SPITE_REALTIME_MAX_QUEUED_UPDATES=256
SPITE_REALTIME_MAX_QUEUED_BYTES=524288
SPITE_REALTIME_SNAPSHOT_INTERVAL_MS=30000
SPITE_REALTIME_COMPACT_AFTER_UPDATES=128

# Shared Cloudflare R2 storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# SPITE generation provider. Required until OpenRouter migration is complete.
FAL_KEY=

