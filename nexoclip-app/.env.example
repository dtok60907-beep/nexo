# Server-side OpenRouter credential used by AI Storyboard / ViMax (never expose to browser).
OPENROUTER_API_KEY=
# Optional direct image/video fallback providers.
GEMINI_API_KEY=
OPENAI_API_KEY=
BYTEPLUS_API_KEY=
# Server-only BytePlus Assets credentials and placement defaults.
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
BYTEPLUS_PROJECT_NAME=default
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_BASE_URL=
BYTEPLUS_SEEDANCE_2_ENDPOINT=ep-20260916130459-fw94z
BYTEPLUS_SEEDANCE_2_5_ENDPOINT=ep-20260916130618-t2z5j
BYTEPLUS_SEEDREAM_5_ENDPOINT=ep-20260916130838-dkscq

# Optional ViMax overrides. These are the OpenRouter defaults when unset.
# VIMAX_LLM_MODEL=openai/gpt-oss-20b:free
# VIMAX_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# VIMAX_VIDEO_MODEL=bytedance/seedance-2.0
# VIMAX_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# VIMAX_RERANKER_MODEL=qwen/qwen3-reranker-8b
# VIMAX_LLM_BASE_URL=https://openrouter.ai/api/v1
# VIMAX_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# VIMAX_VIDEO_BASE_URL=https://openrouter.ai/api/v1
# VIMAX_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# VIMAX_RERANKER_BASE_URL=https://openrouter.ai/api/v1

# Image Studio's standalone OpenRouter route.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# External SPITE canvas service shown in the NexoClip sidebar.
NEXT_PUBLIC_SPITE_URL=/spite
NEXT_PUBLIC_REALTIME_URL=/spite/ws

# Local server-side realtime wiring (development defaults only).
# Production contract lives in .env.production.example and requires explicit values.
CANVAS_AUTH_URL=http://localhost:3007/internal/authorize
NEXOCLIP_INTERNAL_URL=http://localhost:3000
CANVAS_AUTH_HMAC_SECRET=development-only-change-me
REALTIME_JWT_SECRET=development-only-change-me
