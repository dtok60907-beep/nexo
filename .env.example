# Root Docker Compose deployment configuration.
# Copy to `.env` or configure these names in the deployment platform.
# Do not commit actual secret values.

# -----------------------------------------------------------------------------
# Required: infrastructure and Canvas
# -----------------------------------------------------------------------------
# Password for the private Redis queue. Use a long random value.
REDIS_PASSWORD=
# Separate Postgres connection string used by SPITE/Canvas (include sslmode=require
# for Neon/Supabase). NexoClip's primary DB is the internal Compose Postgres service.
DATABASE_URL_SPITE=
# Long random secrets shared by NexoClip, Canvas, and Canvas realtime.
CANVAS_AUTH_HMAC_SECRET=
REALTIME_JWT_SECRET=
# Shared bearer token for NexoClip <-> AI Clip internal traffic.
AI_CLIP_RUNTIME_TOKEN=
# Encrypts locally stored assets; changing it makes existing encrypted assets unreadable.
LOCAL_OBJECT_STORAGE_SECRET=

# -----------------------------------------------------------------------------
# Required by the Canvas generation runtime
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
BYTEPLUS_API_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
BYTEPLUS_PROJECT_NAME=default
BYTEPLUS_REGION=ap-southeast-1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Public URLs — supplied at IMAGE BUILD time by Docker Compose.
# Set them to the final public Studio URL before `docker compose build/up --build`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STUDIO_URL=https://studio.example.com/studio
NEXT_PUBLIC_SPITE_URL=https://studio.example.com/spite
# Leave this as the same-origin path when Caddy proxies Canvas realtime.
NEXT_PUBLIC_REALTIME_URL=/spite/ws

# -----------------------------------------------------------------------------
# Optional AI providers/features
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Used as a fallback if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=
MUAPI_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_SEEDANCE_2_ENDPOINT=ep-20260916130459-fw94z
BYTEPLUS_SEEDANCE_2_5_ENDPOINT=ep-20260916130618-t2z5j
BYTEPLUS_SEEDREAM_5_ENDPOINT=ep-20260916130838-dkscq
R2_PUBLIC_URL=
R2_PROXY_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ORIGIN=

# -----------------------------------------------------------------------------
# Optional runtime tuning and ownership migration
# -----------------------------------------------------------------------------
IMAGE_WORKER_CONCURRENCY=3
VIDEO_WORKER_CONCURRENCY=3
SPITE_OWNER_USER_ID=
# Set to 0 after explicitly assigning Canvas project ownership in production.
SPITE_ALLOW_DETERMINISTIC_FIRST_USER=1
SPITE_REALTIME_MAX_QUEUED_UPDATES=256
SPITE_REALTIME_MAX_QUEUED_BYTES=524288
SPITE_REALTIME_SNAPSHOT_INTERVAL_MS=30000
SPITE_REALTIME_COMPACT_AFTER_UPDATES=128

# Optional overrides for internal service URLs. Defaults are correct for this Compose file.
NEXOCLIP_INTERNAL_URL=http://nexoclip-app:3000
CANVAS_AUTH_URL=http://spite-realtime:3007/internal/authorize
